# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

# JS/CSS bundles — long cache (content-hashed filenames)
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# ALL routes — never cache HTML at CDN or browser level
/*
  Cache-Control: no-cache,no-store,must-revalidate
  X-Frame-Options: DENY

# Override: JS/CSS bundles can still be cached
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# API routes
/api/*
  Cache-Control: no-cache,no-store,must-revalidate

# BUILD_ID must always be fresh
/BUILD_ID
  Cache-Control: no-cache,no-store,must-revalidate
